%global debug_package %{nil}
%global vendordir %{_prefix}/lib/qubes-terraform

Name:           qubes-terraform
Version:        @VERSION@
Release:        @REL@%{?dist}
Summary:        Terraform/OpenTofu provider for Qubes OS
License:        GPL-3.0-or-later
URL:            https://github.com/deeplow/qubes-terraform
Source0:        %{name}-%{version}.tar.gz
Source1:        tf-1.2.0-py3-none-any.whl
Source2:        cryptography-50.0.1-cp311-abi3-manylinux2014_x86_64.manylinux_2_17_x86_64.whl
Source3:        grpcio-1.84.0-cp314-cp314-manylinux2014_x86_64.manylinux_2_17_x86_64.whl
Source4:        protobuf-5.29.6-py3-none-any.whl
Source5:        msgpack-1.2.2-cp314-cp314-manylinux2014_x86_64.manylinux_2_17_x86_64.manylinux_2_28_x86_64.whl
Source6:        cffi-2.1.1-cp314-cp314-manylinux2014_x86_64.manylinux_2_17_x86_64.whl
Source7:        pycparser-3.0-py3-none-any.whl
Source8:        typing_extensions-4.16.0-py3-none-any.whl

# Bundles native wheels (grpcio/cryptography/cffi) -> arch-specific, not noarch.
ExclusiveArch:  x86_64

BuildRequires:  python%{python3_pkgversion}-devel
BuildRequires:  python%{python3_pkgversion}-pip
BuildRequires:  python%{python3_pkgversion}-setuptools
BuildRequires:  python%{python3_pkgversion}-wheel

# The version-sensitive Python deps (tf, protobuf, grpcio, cryptography, msgpack)
# are BUNDLED under %{vendordir} -- Fedora's protobuf is too old for tf's
# generated code. qubesadmin is system-only (not on PyPI) and is resolved from
# the system site-packages at runtime, so it stays an explicit Requires.
Requires:       qubes-core-admin-client
Requires:       qubes-core-qrexec
Requires:       opentofu

%description
Terraform/OpenTofu provider for Qubes OS, bound to the Qubes Python Admin API
(qubesadmin). Manage qubes, preferences and qrexec policy declaratively.

The provider's PyPI dependencies (tf, protobuf, grpcio, cryptography, msgpack)
are bundled under %{vendordir}; the system qubesadmin is used at runtime.

%prep
%autosetup -p1 -n %{name}-%{version}

%build
# Nothing to compile -- installed from prebuilt wheels in %%install.

%install
# Bundle the provider + its PyPI deps (from the vendored wheels) into a private
# directory, offline. The launcher below puts that dir first on sys.path so the
# bundled (newer) protobuf/grpcio/tf win, while the system qubesadmin still
# resolves from the system site-packages.
mkdir -p _wheelhouse
cp %{SOURCE1} %{SOURCE2} %{SOURCE3} %{SOURCE4} %{SOURCE5} %{SOURCE6} %{SOURCE7} %{SOURCE8} _wheelhouse/
%{python3} -m pip install \
    --no-index --no-build-isolation --find-links _wheelhouse \
    --target %{buildroot}%{vendordir} .
# Drop pip-generated console scripts we don't ship.
rm -rf %{buildroot}%{vendordir}/bin

# Launcher -- the executable Terraform/OpenTofu invokes.
install -d %{buildroot}%{_bindir}
cat > %{buildroot}%{_bindir}/terraform-provider-qubes <<EOF
#!/usr/bin/python3
import sys
sys.path.insert(0, "%{vendordir}")
from qubes_provider.main import main
sys.exit(main())
EOF
chmod 0755 %{buildroot}%{_bindir}/terraform-provider-qubes

# Implicit OpenTofu/Terraform local filesystem mirror so `tofu init` finds it
# offline (both default registry hosts).
for host in registry.opentofu.org registry.terraform.io; do
    install -d %{buildroot}%{_datadir}/opentofu/plugins/$host/deeplow/qubes/%{version}/linux_amd64
    ln -s %{_bindir}/terraform-provider-qubes \
        %{buildroot}%{_datadir}/opentofu/plugins/$host/deeplow/qubes/%{version}/linux_amd64/terraform-provider-qubes_v%{version}
done

%files
%license LICENSE
%doc README.md
%{vendordir}/
%{_bindir}/terraform-provider-qubes
%{_datadir}/opentofu/plugins/

%changelog
@CHANGELOG@
